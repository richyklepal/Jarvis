# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-opus-4-8

# Voice providers — local (free, private) or cloud
#   STT_PROVIDER: voicestudio | whisper | deepgram     TTS_PROVIDER: voicestudio | elevenlabs
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs

# VoiceStudio (local ElevenLabs/Deepgram replacement) — github.com/debpalash/VoiceStudio
VOICESTUDIO_URL=http://localhost:3900
VOICESTUDIO_API_KEY=
VOICESTUDIO_VOICE=default
VOICESTUDIO_TTS_MODEL=omnivoice

# Local Whisper (STT_PROVIDER=whisper) — pip install faster-whisper
WHISPER_MODEL=base.en
WHISPER_DEVICE=auto

# Deepgram (speech-to-text) — deepgram.com
DEEPGRAM_API_KEY=your_key_here

# ElevenLabs (text-to-speech) — elevenlabs.io
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Obsidian — absolute path to your vault folder. Jarvis logs everything under <vault>/Jarvis/
OBSIDIAN_VAULT_PATH=/Users/you/Documents/ObsidianVault

# GitHub learning — token only needed for private repos (fine-grained, read-only Contents + Metadata)
GITHUB_USER=richyklepal
GITHUB_TOKEN=

# Local image generation (free) — set up with scripts/setup_local_images.sh
#   IMAGE_PROVIDER: auto (local if installed, else cloud) | local | cloud
IMAGE_PROVIDER=auto
LOCAL_IMAGE_MODEL=z-image-turbo
# JARVIS_LOCAL_AI_DIR=~/.jarvis/local-ai

# Image/video generation (Higgsfield replacement) — MuAPI, the engine behind Open-Generative-AI. PAID per generation.
MUAPI_API_KEY=
