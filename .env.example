# Obsidian — absolute path to your vault folder. Jarvis logs everything under <vault>/Jarvis/
OBSIDIAN_VAULT_PATH=/Users/you/Documents/ObsidianVault

# GitHub learning — token only needed for private repos (fine-grained, read-only Contents + Metadata)
GITHUB_USER=richyklepal
GITHUB_TOKEN=
